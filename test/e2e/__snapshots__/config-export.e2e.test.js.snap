                "types": [
                  "ENCRYPT",
                  "DECRYPT",
                ],
              },
            ],
            "providerName": "&{openidm.keystore.provider|SunJCE}",
            "storePassword": "&{openidm.keystore.password|changeit}",
            "storetype": "&{openidm.keystore.type|JCEKS}",
          },
          "name": "mainKeyStore",
        },
        {
