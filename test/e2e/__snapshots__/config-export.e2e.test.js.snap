exports[`frodo config export "frodo config export -AsxD exportAllTestDir2": should export everything into separate files in the directory exportAllTestDir2 with scripts extracted and mappings separate: exportAllTestDir2/realm/root-alpha/script/Alpha-endUserUIClient-OAuth2-Access-Token-Modification-Script.script.js 1`] = `
"(function () {
  if (scopes.contains('fr:autoaccess:*') || scopes.contains('fr:iga:*') || scopes.contains('fr:idc:analytics:*')) {
    var fr = JavaImporter(
      com.sun.identity.idm.IdType
    );
    var groups = [];
    identity.getMemberships(fr.IdType.GROUP).toArray().forEach(function (group) {
      groups.push(group.getAttribute('cn').toArray()[0]);
    });
    accessToken.setField('groups', groups);
  }
}());
"
