 * 
 * The Scripted Decision Node needs the following outcomes defined:
 * - true
 */
(function () {
  outcome = 'true';

  var p1UserIdAmAttr = 'fr-attr-istr1';
  var p1UserIdIdmAttr = 'frIndexedString1';
