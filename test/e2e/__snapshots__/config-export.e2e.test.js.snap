          "config": {
            "filter": {
              "actions": [
                "create",
                "update",
                "delete",
                "patch",
                "action",
              ],
            },
          },
        },
        "exceptionFormatter": {
          "file": "bin/defaults/script/audit/stacktraceFormatter.js",
          "type": "text/javascript",
        },
      },
      "authentication": {
        "_id": "authentication",
        "serverAuthContext": {
          "authModules": [
            {
              "enabled": true,
              "name": "STATIC_USER",
              "properties": {
                "defaultUserRoles": [
                  "internal/role/openidm-reg",
                ],
                "password": {
                  "$crypto": {
