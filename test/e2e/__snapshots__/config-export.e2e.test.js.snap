      },
      "members": {
        "description": "Application Members",
        "items": {
          "id": "urn:jsonschema:org:forgerock:openidm:managed:api:Application:members:items",
          "properties": {
            "_ref": {
              "description": "References a relationship from a managed object",
              "type": "string",
