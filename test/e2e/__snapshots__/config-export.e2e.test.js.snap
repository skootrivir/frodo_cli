  "script": {
    "bb0b46f8-bdf3-4fb8-8d8f-bd921af7e79e": {
      "_id": "bb0b46f8-bdf3-4fb8-8d8f-bd921af7e79e",
      "context": "AUTHENTICATION_TREE_DECISION_NODE",
      "createdBy": "null",
