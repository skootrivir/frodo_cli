exports[`frodo config export "frodo config export -AsxD exportAllTestDir2": should export everything into separate files in the directory exportAllTestDir2 with scripts extracted and mappings separate: exportAllTestDir2/global/idm/external.email.idm.json 1`] = `
{
  "idm": {
    "external.email": {
      "_id": "external.email",
      "auth": {
        "enable": true,
        "password": "&{aic.customer.sasl.pass}",
        "username": "&{aic.customer.sasl.user|donotuse@pingidentity.com}",
      },
      "connectiontimeout": 300000,
      "debug": false,
      "from": "&{email.sender.address}",
      "host": "&{aic.smtp.relay.host|smtp-relay.fr-platform.svc.cluster.local}",
      "port": 25,
      "smtpProperties": [],
      "ssl": {
        "enable": false,
      },
      "starttls": {
        "enable": false,
      },
      "threadPoolSize": 20,
      "timeout": 300000,
      "writetimeout": 300000,
    },
  },
  "meta": Any<Object>,
}
`;

