          "roles": "internal/role/openidm-authorized",
        },
        {
          "actions": "*",
          "customAuthz": "ownRelationshipCollection(['_meta','_notifications'])",
          "methods": "read,query",
          "pattern": "managed/user/*",
          "roles": "internal/role/openidm-authorized",
        },
        {
          "actions": "",
          "customAuthz": "ownDataOnly()",
          "methods": "read,delete",
