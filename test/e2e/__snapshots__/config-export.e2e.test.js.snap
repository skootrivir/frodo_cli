                    "referencedObjectFields": [
                      "_id",
                      "parentIDs",
                    ],
                    "referencedRelationshipFields": [
                      "parent",
                    ],
                  },
                  "returnByDefault": true,
                  "searchable": false,
                  "title": "parent org ids",
                  "type": "array",
                  "userEditable": false,
                  "viewable": false,
                },
                "parentOwnerIDs": {
                  "isVirtual": true,
                  "items": {
                    "title": "user ids of parent owners",
                    "type": "string",
                  },
                  "queryConfig": {
                    "flattenProperties": true,
                    "referencedObjectFields": [
                      "ownerIDs",
                      "parentOwnerIDs",
                    ],
