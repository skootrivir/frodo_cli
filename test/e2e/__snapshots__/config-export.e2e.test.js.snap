          "description": "Normalizes raw profile data from GitHub",
          "evaluatorVersion": "1.0",
          "language": "GROOVY",
          "lastModifiedBy": "id=7a031a92-f70d-4b30-9d70-da7cfb1d9c93,ou=user,ou=am-config",
