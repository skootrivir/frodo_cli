      "ui/dashboard": {
        "_id": "ui/dashboard",
        "adminDashboards": [
          {
            "isDefault": true,
            "name": "Quick Start",
            "widgets": [
              {
                "cards": [
                  {
                    "href": "#connectors/add/",
                    "icon": "fa-database",
                    "name": "Add Connector",
                  },
                  {
                    "href": "#mapping/add/",
                    "icon": "fa-map-marker",
                    "name": "Create Mapping",
                  },
