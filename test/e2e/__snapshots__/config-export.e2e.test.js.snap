            "roles": "internal/role/openidm-admin",
          },
          {
            "actions": "",
            "methods": "create,read,update,delete,patch,query",
            "pattern": "system/*",
            "roles": "internal/role/openidm-admin",
          },
          {
            "actions": "*",
            "methods": "script",
            "pattern": "system/*",
            "roles": "internal/role/openidm-admin",
          },
          {
            "actions": "test,testConfig,createconfiguration,liveSync,authenticate",
            "methods": "action",
