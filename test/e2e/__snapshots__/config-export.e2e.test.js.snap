        "_id": "ui.context/api",
        "authEnabled": true,
        "cacheEnabled": false,
        "defaultDir": "&{idm.install.dir}/ui/api/default",
        "enabled": true,
        "extensionDir": "&{idm.install.dir}/ui/api/extension",
        "urlContextRoot": "/api",
