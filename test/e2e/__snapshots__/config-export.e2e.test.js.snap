                          },
                          {
                            "params": {
                              "types": [
                                "string",
                              ],
                            },
                            "policyId": "valid-type",
                          },
                        ],
                      },
                      {
                        "name": "path",
                        "policies": [
                          {
                            "policyId": "required",
                          },
                          {
                            "policyId": "not-empty",
                          },
                          {
                            "params": {
                              "forbiddenChars": [
                                "/*",
                              ],
                            },
                            "policyId": "cannot-contain-characters",
                          },
                          {
                            "policyId": "valid-privilege-path",
                          },
                        ],
                      },
                      {
                        "name": "accessFlags",
                        "policies": [
                          {
                            "policyId": "required",
                          },
                          {
                            "policyId": "not-empty",
                          },
                          {
                            "params": {
                              "types": [
                                "array",
                              ],
                            },
                            "policyId": "valid-type",
                          },
                          {
