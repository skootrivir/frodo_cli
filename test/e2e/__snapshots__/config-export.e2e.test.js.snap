                  {
                    "params": {
                      "properties": [
                        {
                          "name": "name",
                          "policies": [
                            {
                              "policyId": "required",
                            },
                            {
                              "policyId": "not-empty",
                            },
                            {
                              "params": {
                                "types": [
                                  "string",
                                ],
                              },
                              "policyId": "valid-type",
                            },
                          ],
                        },
                        {
                          "name": "path",
                          "policies": [
                            {
                              "policyId": "required",
                            },
                            {
                              "policyId": "not-empty",
                            },
                            {
                              "params": {
                                "forbiddenChars": [
                                  "/*",
                                ],
                              },
                              "policyId": "cannot-contain-characters",
                            },
                            {
                              "policyId": "valid-privilege-path",
                            },
                          ],
                        },
                        {
                          "name": "accessFlags",
