exports[`frodo config export "frodo config export -AsxD exportAllTestDir2": should export everything into separate files in the directory exportAllTestDir2 with scripts extracted and mappings separate: exportAllTestDir2/global/idm/internal.idm.json 1`] = `
{
  "idm": {
    "internal": {
      "_id": "internal",
      "objects": [
        {
          "name": "role",
          "properties": {
            "authzMembers": {
              "items": {
                "resourceCollection": [
                  {
                    "conditionalAssociation": true,
                    "label": "User",
                    "notify": true,
                    "path": "managed/alpha_user",
                    "query": {
                      "fields": [
                        "userName",
                        "givenName",
                        "sn",
                      ],
                      "queryFilter": "true",
                    },
                  },
                ],
              },
            },
          },
        },
      ],
    },
  },
  "meta": Any<Object>,
