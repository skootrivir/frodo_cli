{
  "meta": Any<Object>,
  "script": {
    "da7a96a8-7969-4dab-9c6e-a812938cc76d": {
      "_id": "da7a96a8-7969-4dab-9c6e-a812938cc76d",
      "context": "LIBRARY",
      "createdBy": "null",
      "creationDate": 0,
