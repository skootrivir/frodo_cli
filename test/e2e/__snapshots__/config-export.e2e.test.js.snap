                "sync",
                "authentication",
                "config",
              ],
            },
          },
          {
            "class": "org.forgerock.openidm.audit.impl.RepositoryAuditEventHandler",
            "config": {
              "enabled": {
                "$bool": "&{openidm.audit.handler.repo.enabled|false}",
              },
              "name": "repo",
              "topics": [
                "access",
                "activity",
                "sync",
                "authentication",
                "config",
              ],
            },
          },
        ],
        "eventTopics": {
          "activity": {
            "filter": {
              "actions": [
                "create",
                "update",
                "delete",
                "patch",
                "action",
              ],
            },
            "passwordFields": [
