              "roles": {
                "isMultiValued": true,
                "ldapAttribute": "fr-idm-managed-user-roles",
                "primaryKey": "uid",
                "resourcePath": "managed/role",
                "type": "reference",
              },
            },
          },
          "reconprogressstate": {
