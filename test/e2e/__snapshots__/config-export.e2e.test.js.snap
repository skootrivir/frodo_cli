console.log(\`Area of circle with radius 7: \${7 * 7 * systemEnv.getProperty("esv.test.var.pi")}\`);
console.log(\`Volume of sphere with radius 7: \${4 * 7 * 7 * 7 * systemEnv.getProperty("esv.test.secret.pi") / 3}\`);
"
`;

