        "_id": "federation/common",
        "collection": false,
        "name": "Common Federation Configuration",
      },
      "algorithms": {
        "DigestAlgorithm": "http://www.w3.org/2001/04/xmlenc#sha256",
        "QuerySignatureAlgorithmDSA": "http://www.w3.org/2009/xmldsig11#dsa-sha256",
